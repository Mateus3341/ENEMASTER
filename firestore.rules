rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profile documents
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId);
      allow delete: if false;

      // User's essay subcollection
      match /essays/{essayId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Global application metadata & user/visitor counters
    match /app_metadata/{docId} {
      allow read: if true; // anyone can see public user count & visitor stats
      allow create, update: if true; // allow recording visits and login events
      allow delete: if false;
    }

    // Connection check document
    match /_connection_test/{docId} {
      allow read, write: if true;
    }
  }
}
